<!-- Reusable Transaction Modal -->
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="txModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow border-0" style="border-radius: 1rem;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="txModalTitle" style="color: #0B1F3A;">Add Transaction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-4 pt-3 pb-4">
        <form id="transactionForm" novalidate>
          <input type="hidden" id="txId" value="" />

          <!-- Income/Expense Type Toggle -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Transaction Type</label>
            <div class="btn-group w-100" role="group" id="txTypeGroup">
              <input type="radio" class="btn-check" name="txType" id="txTypeExpense" value="expense" checked autocomplete="off">
              <label class="btn btn-outline-danger fw-semibold py-2" for="txTypeExpense">
                <i class="bi bi-arrow-down-circle me-1"></i> Expense
              </label>

              <input type="radio" class="btn-check" name="txType" id="txTypeIncome" value="income" autocomplete="off">
              <label class="btn btn-outline-success fw-semibold py-2" for="txTypeIncome">
                <i class="bi bi-arrow-up-circle me-1"></i> Income
              </label>
            </div>
            <div class="invalid-feedback" id="txTypeError"></div>
          </div>

          <!-- Amount -->
          <div class="mb-3">
            <label for="txAmount" class="form-label small fw-semibold text-muted">Amount</label>
            <div class="input-group">
              <span class="input-group-text fw-bold bg-light" style="color: #0B1F3A;">₹</span>
              <input type="number" step="0.01" min="0.01" max="10000000" class="form-control form-control-lg fw-semibold" id="txAmount" placeholder="0.00" required>
              <div class="invalid-feedback" id="txAmountError">Please enter an amount between 0.01 and 10,000,000.</div>
            </div>
          </div>

          <!-- Category -->
          <div class="mb-3">
            <label for="txCategory" class="form-label small fw-semibold text-muted">Category</label>
            <select class="form-select" id="txCategory" required>
              <option value="">Select Category</option>
            </select>
            <div class="invalid-feedback" id="txCategoryError">Please select a category.</div>
          </div>

          <!-- Date -->
          <div class="mb-3">
            <label for="txDate" class="form-label small fw-semibold text-muted">Date</label>
            <input type="date" class="form-control" id="txDate" required>
            <div class="invalid-feedback" id="txDateError">Please enter a valid date (not more than 1 day ahead).</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="txDescription" class="form-label small fw-semibold text-muted mb-0">Description (Optional)</label>
              <span class="text-muted small"><span id="txDescCounter">0</span>/200</span>
            </div>
            <textarea class="form-control" id="txDescription" rows="2" maxlength="200" placeholder="e.g. Grocery shopping, monthly rent..."></textarea>
            <div class="invalid-feedback" id="txDescError">Description cannot exceed 200 characters.</div>
          </div>

          <!-- Action buttons -->
          <div class="d-flex justify-content-end gap-2 pt-2 border-top">
            <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-teal px-4 fw-semibold" id="txSubmitBtn">
              <span class="spinner-border spinner-border-sm me-1 d-none" id="txSubmitSpinner" role="status" aria-hidden="true"></span>
              <span id="txSubmitText">Save Transaction</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
