<h4 class="text-center mb-4" style="color:#0B1F3A;">Welcome Back</h4>
<div id="form-error" class="alert alert-danger d-none"></div>
<form id="login-form" data-form="login">
  <div class="mb-3">
    <label class="form-label fw-semibold">Email</label>
    <input type="email" class="form-control" name="email" id="email" required />
    <div class="invalid-feedback" id="email-error"></div>
  </div>
  <div class="mb-3">
    <label class="form-label fw-semibold">Password</label>
    <div class="input-group">
      <input type="password" class="form-control" name="password" id="password" required />
      <button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Toggle password visibility">
        <i class="bi bi-eye" id="eyeIcon"></i>
      </button>
    </div>
    <div class="invalid-feedback" id="password-error"></div>
  </div>
  <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background:#0B1F3A;border-color:#0B1F3A;" id="submitBtn">
    <span id="btnText">Sign In</span>
    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none ms-2"></span>
  </button>
</form>
<p class="text-center mt-3 mb-0">Don't have an account? <a href="/register" style="color:#0FB5A6;">Register</a></p>
