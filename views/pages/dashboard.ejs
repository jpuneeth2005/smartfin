<div class="container-fluid px-0">
  <!-- Header: Greeting, Date, Action Buttons -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1" style="color: #0B1F3A;">
        Welcome back, <%= currentUser ? currentUser.name : 'User' %>! 👋
      </h2>
      <p class="text-muted mb-0" id="currentDateDisplay">
        <i class="bi bi-calendar3 me-1"></i>
        <span><%= new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-success fw-semibold d-flex align-items-center gap-2 shadow-sm" onclick="SmartFin.transactionModal.open({ type: 'income' })">
        <i class="bi bi-plus-circle"></i> Add Income
      </button>
      <button type="button" class="btn btn-danger fw-semibold d-flex align-items-center gap-2 shadow-sm" onclick="SmartFin.transactionModal.open({ type: 'expense' })">
        <i class="bi bi-dash-circle"></i> Add Expense
      </button>
    </div>
  </div>

  <!-- 4 Main Stat Cards -->
  <div class="row g-3 mb-4">
    <!-- Total Balance -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-primary shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Total Balance</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-wallet2 fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statBalance">
            <div class="skeleton-shimmer" style="height: 32px; width: 140px;"></div>
          </div>
          <small class="text-white text-opacity-75">Lifetime Net Balance</small>
        </div>
      </div>
    </div>

    <!-- Total Income -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-income shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Total Income</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-graph-up-arrow fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statTotalIncome">
            <div class="skeleton-shimmer" style="height: 32px; width: 140px;"></div>
          </div>
          <small class="text-white text-opacity-75">Lifetime Total</small>
        </div>
      </div>
    </div>

    <!-- Total Expenses -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-expense shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Total Expenses</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-graph-down-arrow fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statTotalExpense">
            <div class="skeleton-shimmer" style="height: 32px; width: 140px;"></div>
          </div>
          <small class="text-white text-opacity-75">Lifetime Total</small>
        </div>
      </div>
    </div>

    <!-- Savings This Month -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-teal shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Savings This Month</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-piggy-bank fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statMonthSavings">
            <div class="skeleton-shimmer" style="height: 32px; width: 140px;"></div>
          </div>
          <small class="text-white text-opacity-75">Income - Expense</small>
        </div>
      </div>
    </div>
  </div>

  <!-- 2 Small Cards / Quick Indicators -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
      <div class="card border-0 shadow-sm p-3" style="border-radius: 0.75rem;">
        <div class="d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-3" style="background-color: rgba(239,68,68,0.1); color: #ef4444;">
              <i class="bi bi-calendar-event fs-4"></i>
            </div>
            <div>
              <div class="text-muted small fw-semibold text-uppercase">Today's Expenses</div>
              <div class="fs-4 fw-bold text-expense" id="statTodayExpense">
                <div class="skeleton-shimmer" style="height: 24px; width: 100px;"></div>
              </div>
            </div>
          </div>
          <span class="badge bg-light text-muted border">Today</span>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="card border-0 shadow-sm p-3" style="border-radius: 0.75rem;">
        <div class="d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-3" style="background-color: rgba(239,68,68,0.1); color: #ef4444;">
              <i class="bi bi-calendar-month fs-4"></i>
            </div>
            <div>
              <div class="text-muted small fw-semibold text-uppercase">This Month's Expenses</div>
              <div class="fs-4 fw-bold text-expense" id="statMonthExpense">
                <div class="skeleton-shimmer" style="height: 24px; width: 100px;"></div>
              </div>
            </div>
          </div>
          <span class="badge bg-light text-muted border">This Month</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart & Recent Transactions Section -->
  <div class="row g-4">
    <!-- Chart: Income vs Expense, last 6 months -->
    <div class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0" style="color: #0B1F3A;">Income vs Expense (Last 6 Months)</h5>
          <span class="text-muted small"><i class="bi bi-bar-chart me-1"></i>Monthly comparison</span>
        </div>
        <div class="card-body px-4 pb-4 pt-1 position-relative">
          <div id="chartSkeleton" class="d-flex align-items-end justify-content-around h-100 py-4" style="min-height: 280px;">
            <div class="skeleton-shimmer" style="height: 40%; width: 30px;"></div>
            <div class="skeleton-shimmer" style="height: 65%; width: 30px;"></div>
            <div class="skeleton-shimmer" style="height: 50%; width: 30px;"></div>
            <div class="skeleton-shimmer" style="height: 85%; width: 30px;"></div>
            <div class="skeleton-shimmer" style="height: 60%; width: 30px;"></div>
            <div class="skeleton-shimmer" style="height: 75%; width: 30px;"></div>
          </div>
          <div id="chartContainer" style="display: none; height: 300px;">
            <canvas id="monthlyChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Transactions (5) -->
    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0" style="color: #0B1F3A;">Recent Transactions</h5>
          <a href="/transactions" class="small fw-semibold text-teal text-decoration-none">
            View all <i class="bi bi-arrow-right"></i>
          </a>
        </div>
        <div class="card-body p-0">
          <!-- Recent skeleton -->
          <div id="recentSkeleton" class="p-3">
            <div class="skeleton-shimmer mb-3" style="height: 45px; width: 100%;"></div>
            <div class="skeleton-shimmer mb-3" style="height: 45px; width: 100%;"></div>
            <div class="skeleton-shimmer mb-3" style="height: 45px; width: 100%;"></div>
            <div class="skeleton-shimmer mb-3" style="height: 45px; width: 100%;"></div>
            <div class="skeleton-shimmer" style="height: 45px; width: 100%;"></div>
          </div>

          <!-- Recent list -->
          <ul class="list-group list-group-flush d-none" id="recentList">
            <!-- Populated by JS -->
          </ul>

          <!-- Empty state -->
          <div id="recentEmptyState" class="text-center py-5 d-none">
            <i class="bi bi-receipt-cutoff fs-1 text-muted"></i>
            <p class="text-muted small mt-2 mb-3">No recent transactions yet.</p>
            <button type="button" class="btn btn-teal btn-sm" onclick="SmartFin.transactionModal.open({ type: 'expense' })">
              Record First Transaction
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .skeleton-shimmer {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: 6px;
  }
</style>
