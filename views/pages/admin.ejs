<div class="container-fluid px-0">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1" style="color: #0B1F3A;">Admin Console</h2>
      <p class="text-muted mb-0">System metrics, user management, and platform oversight.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge px-3 py-2 fw-medium" style="background: rgba(15, 181, 166, 0.15); color: #0FB5A6; font-size: 0.85rem;">
        <i class="bi bi-shield-check me-1"></i> Admin Authorization Active
      </span>
    </div>
  </div>

  <!-- 4 Stat Cards -->
  <div class="row g-3 mb-4">
    <!-- Total Users -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-primary shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Total Users</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-people-fill fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statTotalUsers">
            <div class="skeleton-shimmer" style="height: 32px; width: 100px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
          </div>
          <small class="text-white text-opacity-75">Registered platform accounts</small>
        </div>
      </div>
    </div>

    <!-- Active Users -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-teal shadow-sm h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Active Users</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-person-check-fill fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statActiveUsers">
            <div class="skeleton-shimmer" style="height: 32px; width: 100px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
          </div>
          <small class="text-white text-opacity-75">Users with enabled access</small>
        </div>
      </div>
    </div>

    <!-- New Users (Last 7 Days) -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card shadow-sm h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">New (Last 7 Days)</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-person-plus-fill fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statNewUsers">
            <div class="skeleton-shimmer" style="height: 32px; width: 100px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
          </div>
          <small class="text-white text-opacity-75">Recent registrations</small>
        </div>
      </div>
    </div>

    <!-- Total Records (Transactions & Budgets Counts Only) -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card shadow-sm h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0ea5e9, #0284c7);">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-label text-uppercase fw-semibold" style="letter-spacing: 0.5px;">System Activity</span>
          <div class="p-2 rounded bg-white bg-opacity-10 text-white">
            <i class="bi bi-database-fill fs-5"></i>
          </div>
        </div>
        <div>
          <div class="stat-value" id="statSystemRecords" style="font-size: 1.45rem;">
            <div class="skeleton-shimmer" style="height: 32px; width: 120px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
          </div>
          <small class="text-white text-opacity-75" id="statSystemSubtext">Total Transactions & Budgets</small>
        </div>
      </div>
    </div>
  </div>

  <!-- User Management Card -->
  <div class="card border-0 shadow-sm" style="border-radius: 0.75rem;">
    <!-- Card Header / Search Bar -->
    <div class="card-header bg-white border-bottom py-3 px-4">
      <div class="row g-3 align-items-center justify-content-between">
        <div class="col-12 col-md-5">
          <h5 class="fw-bold mb-0 text-navy">User Directory</h5>
          <small class="text-muted">Search and manage platform users</small>
        </div>
        <div class="col-12 col-md-6 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted">
              <i class="bi bi-search"></i>
            </span>
            <input
              type="text"
              id="userSearchInput"
              class="form-control border-start-0 bg-light"
              placeholder="Search by name or email..."
              aria-label="Search users by name or email"
            />
            <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn" title="Clear search" aria-label="Clear search">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Table Body -->
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
          <thead class="table-light border-bottom">
            <tr>
              <th scope="col" class="ps-4 py-3">User</th>
              <th scope="col" class="py-3">Role</th>
              <th scope="col" class="py-3">Status</th>
              <th scope="col" class="py-3">Joined</th>
              <th scope="col" class="py-3">Last Login</th>
              <th scope="col" class="pe-4 py-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <!-- Populated by admin.js -->
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="usersEmptyState" class="text-center py-5 d-none">
        <div class="mb-3 text-muted">
          <i class="bi bi-person-x fs-1 text-secondary"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No users found</h5>
        <p class="text-muted small mb-0">Try searching with a different name or email.</p>
      </div>
    </div>

    <!-- Pagination Footer -->
    <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
      <div class="small text-muted" id="userPaginationSummary">
        Showing <span id="showingStart">0</span>-<span id="showingEnd">0</span> of <span id="totalUsersCount">0</span> users
      </div>
      <nav aria-label="Users table navigation">
        <ul class="pagination pagination-sm mb-0" id="userPaginationControls">
          <!-- Populated by admin.js -->
        </ul>
      </nav>
    </div>
  </div>
</div>

<!-- Status Toggle Confirmation Modal -->
<div class="modal fade" id="statusConfirmModal" tabindex="-1" aria-labelledby="statusConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold text-navy" id="statusConfirmModalLabel">Confirm Status Change</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close modal"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <div id="statusModalIcon" class="mb-3 fs-1"></div>
        <p class="mb-2 fs-6 fw-semibold text-dark" id="statusModalMessage"></p>
        <p class="text-muted small mb-0" id="statusModalSubtext"></p>
      </div>
      <div class="modal-footer border-top bg-light">
        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn px-4 fw-semibold" id="confirmStatusChangeBtn">Confirm</button>
      </div>
    </div>
  </div>
</div>
