<div class="container-fluid px-0">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1" style="color: #0B1F3A;">Transactions</h2>
      <p class="text-muted mb-0">View, search, and manage all your income and expenses.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-success fw-semibold d-flex align-items-center gap-2 shadow-sm" data-open-transaction="income">
        <i class="bi bi-plus-circle"></i> Add Income
      </button>
      <button type="button" class="btn btn-danger fw-semibold d-flex align-items-center gap-2 shadow-sm" data-open-transaction="expense">
        <i class="bi bi-dash-circle"></i> Add Expense
      </button>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card mb-4 border-0 shadow-sm" style="border-radius: 0.75rem;">
    <div class="card-body p-3 p-md-4">
      <div class="row g-3 align-items-end">
        <!-- Search bar (Debounced 400ms) -->
        <div class="col-12 col-md-4 col-lg-3">
          <label for="filterSearch" class="form-label small fw-semibold text-muted">Search</label>
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="filterSearch" class="form-control border-start-0" placeholder="Description or category...">
          </div>
        </div>

        <!-- Type filter -->
        <div class="col-6 col-md-3 col-lg-2">
          <label for="filterType" class="form-label small fw-semibold text-muted">Type</label>
          <select id="filterType" class="form-select">
            <option value="">All Types</option>
            <option value="income">Income</option>
            <option value="expense">Expense</option>
          </select>
        </div>

        <!-- Category filter -->
        <div class="col-6 col-md-3 col-lg-2">
          <label for="filterCategory" class="form-label small fw-semibold text-muted">Category</label>
          <select id="filterCategory" class="form-select">
            <option value="">All Categories</option>
            <option value="Salary">Salary</option>
            <option value="Food">Food</option>
            <option value="Shopping">Shopping</option>
            <option value="Transport">Transport</option>
            <option value="Education">Education</option>
            <option value="Bills">Bills</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Healthcare">Healthcare</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- From Date -->
        <div class="col-6 col-md-3 col-lg-2">
          <label for="filterFrom" class="form-label small fw-semibold text-muted">From Date</label>
          <input type="date" id="filterFrom" class="form-control">
        </div>

        <!-- To Date -->
        <div class="col-6 col-md-3 col-lg-2">
          <label for="filterTo" class="form-label small fw-semibold text-muted">To Date</label>
          <input type="date" id="filterTo" class="form-control">
        </div>

        <!-- Sort -->
        <div class="col-8 col-md-3 col-lg-2">
          <label for="filterSort" class="form-label small fw-semibold text-muted">Sort By</label>
          <select id="filterSort" class="form-select">
            <option value="date_desc">Newest First</option>
            <option value="date_asc">Oldest First</option>
            <option value="amount_desc">Highest Amount</option>
            <option value="amount_asc">Lowest Amount</option>
          </select>
        </div>

        <!-- Reset Button -->
        <div class="col-4 col-md-2 col-lg-1 d-flex">
          <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-1" title="Reset all filters">
            <i class="bi bi-arrow-counterclockwise"></i> Reset
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Transactions Table Card -->
  <div class="card border-0 shadow-sm" style="border-radius: 0.75rem;">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="transactionsTable">
          <thead class="table-light border-bottom">
            <tr>
              <th scope="col" class="ps-4 py-3">Date</th>
              <th scope="col" class="py-3">Description</th>
              <th scope="col" class="py-3">Category</th>
              <th scope="col" class="py-3">Type</th>
              <th scope="col" class="py-3 text-end">Amount</th>
              <th scope="col" class="pe-4 py-3 text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="txTableBody">
            <!-- Skeleton Rows initially injected by JS -->
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="txEmptyState" class="text-center py-5 d-none">
        <div class="mb-3 text-muted">
          <i class="bi bi-receipt fs-1" style="color: #94a3b8;"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No transactions found</h5>
        <p class="text-muted small mb-3">Try adjusting your search filters or record a new transaction.</p>
        <button type="button" class="btn btn-teal btn-sm px-3" data-open-transaction="expense">
          <i class="bi bi-plus-lg me-1"></i> Add Transaction
        </button>
      </div>
    </div>

    <!-- Pagination Footer -->
    <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
      <div class="small text-muted" id="paginationSummary">
        Showing <span id="showingStart">0</span>-<span id="showingEnd">0</span> of <span id="totalTxCount">0</span> transactions
      </div>
      <nav aria-label="Transactions pagination">
        <ul class="pagination pagination-sm mb-0" id="paginationControls">
          <!-- Populated by JS -->
        </ul>
      </nav>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow" style="border-radius: 1rem;">
      <div class="modal-body p-4 text-center">
        <div class="text-danger mb-3">
          <i class="bi bi-exclamation-triangle fs-1"></i>
        </div>
        <h5 class="fw-bold mb-2">Delete Transaction?</h5>
        <p class="text-muted small mb-4">Are you sure you want to delete this transaction? This action cannot be undone.</p>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger px-3 fw-semibold" id="confirmDeleteBtn">Delete</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Table Skeleton Style -->
<style>
  .skeleton-line {
    height: 14px;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: 4px;
  }
  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
